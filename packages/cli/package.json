{
	"name": "@gabroberge/ts-json-as-const",
	"version": "3.0.0",
	"private": false,
	"description": "A (very) simple CLI tool that reads JSON files and creates .d.ts files with their keys/values explicitly defined",
	"keywords": [
		"const",
		"declaration",
		"declaration files",
		"json",
		"typescript"
	],
	"homepage": "https://github.com/gabroberge/ts-json-as-const#readme",
	"bugs": "https://github.com/gabroberge/ts-json-as-const/issues",
	"license": "MIT",
	"author": "Gabriel Roberge",
	"repository": {
		"type": "git",
		"url": "https://github.com/gabroberge/ts-json-as-const.git"
	},
	"bin": {
		"ts-json-as-const": "./dist/index.mjs"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"lint": "eslint \"src/**/*.ts\"",
		"test": "vitest run",
		"start:dev": "sh -c 'tsdown --config tsdown.dev.config.ts --on-success \"node dist/index.mjs $*\"' sh"
	},
	"devDependencies": {
		"@total-typescript/ts-reset": "^0.6.1",
		"inflection": "^3.0.2",
		"isbinaryfile": "^6.0.0",
		"json5": "^2.2.3",
		"stringify-object": "^7.0.0"
	},
	"peerDependencies": {
		"inflection": "^3.0.2",
		"isbinaryfile": "^6.0.0",
		"json5": "^2.2.3",
		"stringify-object": "^7.0.0"
	}
}
